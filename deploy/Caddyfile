# Automatic HTTPS. Caddy fetches and renews a Let's Encrypt certificate for
# BEE_DOMAIN, so nothing here needs a manual cert or a renewal cron.
#
# HTTPS is not decoration for this app: the session cookie is only marked
# `secure` when BEE_SITE_URL is https, and invite links are emailed as
# absolute URLs.
{$BEE_DOMAIN} {
	encode zstd gzip

	# Caddy sets X-Forwarded-For itself, which the login rate limiter keys on.
	# Without that header every request would look like one client and a single
	# person's failed logins would lock out everybody — so it is load-bearing,
	# just not something this file has to configure.
	reverse_proxy web:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
